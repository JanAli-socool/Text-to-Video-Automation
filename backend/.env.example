SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=24

# Recommended: hosted GPU generation
VIDEO_PROVIDER=replicate
VIDEO_PROVIDER_TOKEN=your-replicate-token
# Seedance 2.0 model page: replicate.com/bytedance/seedance-2.0
VIDEO_PROVIDER_MODEL=bytedance/seedance-2.0

# Use this only for self-hosted GPU workers.
ENABLE_GPU_GENERATION=false
OUTPUT_DIR=./generated_videos
MOCK_GENERATION_DELAY=8
